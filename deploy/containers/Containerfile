# Build abnchd with the module versions pinned in go.mod.
FROM golang:1.27.2-alpine3.24 AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /abnchd ./cmd/abnchd

# Run abnchd from a service config the deployment supplies.
FROM alpine:3.24.3 AS runtime

RUN apk add --no-cache ca-certificates

COPY --from=build /abnchd /usr/local/bin/abnchd

# Exec form so the container command reaches abnchd, which takes the service
# config path as its first argument.
ENTRYPOINT ["/usr/local/bin/abnchd"]
